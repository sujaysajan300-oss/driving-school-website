<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>DriveSmart NZ | Professional Driving Lessons</title>

<meta name="description" content="Professional driving lessons and test preparation in New Zealand.">

<style>

/* =========================
   BASIC SETTINGS
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
    color: #172033;
    background: #ffffff;
}

a {
    text-decoration: none;
    color: inherit;
}

.container {
    width: min(1120px, 92%);
    margin: auto;
}


/* =========================
   NAVIGATION
========================= */

header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255,255,255,0.96);
    border-bottom: 1px solid #e8ebf0;
    backdrop-filter: blur(10px);
}

.navbar {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 24px;
    font-weight: 800;
    color: #101828;
}

.logo span {
    color: #e63946;
}

.nav-links {
    display: flex;
    gap: 28px;
    list-style: none;
}

.nav-links a {
    font-weight: 600;
    color: #344054;
    transition: 0.2s;
}

.nav-links a:hover {
    color: #e63946;
}

.nav-button {
    background: #e63946;
    color: white !important;
    padding: 12px 18px;
    border-radius: 8px;
}

.menu-button {
    display: none;
    font-size: 28px;
    cursor: pointer;
}


/* =========================
   HERO
========================= */

.hero {
    background:
        linear-gradient(135deg, #101828 0%, #1d2939 100%);
    color: white;
    padding: 110px 0;
}

.hero-content {
    max-width: 720px;
}

.badge {
    display: inline-block;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    padding: 8px 14px;
    border-radius: 50px;
    margin-bottom: 20px;
    font-size: 14px;
}

.hero h1 {
    font-size: clamp(42px, 7vw, 72px);
    line-height: 1.05;
    margin-bottom: 24px;
}

.hero h1 span {
    color: #ff5964;
}

.hero p {
    font-size: 19px;
    color: #d0d5dd;
    max-width: 650px;
    margin-bottom: 32px;
}

.buttons {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
}

.btn {
    display: inline-block;
    padding: 15px 23px;
    border-radius: 8px;
    font-weight: 700;
    transition: 0.2s;
}

.btn-primary {
    background: #e63946;
    color: white;
}

.btn-primary:hover {
    transform: translateY(-2px);
    background: #d62839;
}

.btn-secondary {
    border: 1px solid #667085;
    color: white;
}

.btn-secondary:hover {
    background: white;
    color: #101828;
}


/* =========================
   STATS
========================= */

.stats {
    background: #f8fafc;
    padding: 30px 0;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    text-align: center;
}

.stat strong {
    display: block;
    font-size: 28px;
    color: #101828;
}

.stat span {
    color: #667085;
}


/* =========================
   SECTIONS
========================= */

section {
    padding: 90px 0;
}

.section-title {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 50px;
}

.section-title span {
    color: #e63946;
    font-weight: 700;
}

.section-title h2 {
    font-size: 40px;
    margin: 10px 0;
}

.section-title p {
    color: #667085;
}


/* =========================
   ABOUT
========================= */

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
}

.about-box {
    background: #f8fafc;
    padding: 35px;
    border-radius: 16px;
}

.about-box h3 {
    font-size: 28px;
    margin-bottom: 18px;
}

.about-box p {
    color: #667085;
    margin-bottom: 15px;
}

.check-list {
    list-style: none;
}

.check-list li {
    margin: 12px 0;
    font-weight: 600;
}

.check-list li::before {
    content: "✓";
    color: #e63946;
    font-weight: bold;
    margin-right: 10px;
}


/* =========================
   LESSONS
========================= */

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.card {
    border: 1px solid #eaecf0;
    border-radius: 16px;
    padding: 30px;
    background: white;
    transition: 0.25s;
}

.card:hover {
    transform: translateY(-6px);
    box-shadow: 0 15px 40px rgba(16,24,40,0.1);
}

.icon {
    width: 55px;
    height: 55px;
    display: grid;
    place-items: center;
    background: #fff1f2;
    border-radius: 12px;
    font-size: 25px;
    margin-bottom: 20px;
}

.card h3 {
    font-size: 22px;
    margin-bottom: 10px;
}

.card p {
    color: #667085;
}


/* =========================
   PRICING
========================= */

.pricing {
    background: #f8fafc;
}

.price-card {
    position: relative;
}

.price {
    font-size: 38px;
    font-weight: 800;
    margin: 18px 0;
}

.price small {
    font-size: 15px;
    color: #667085;
    font-weight: normal;
}

.price-list {
    list-style: none;
    margin: 25px 0;
}

.price-list li {
    margin: 12px 0;
    color: #475467;
}

.price-list li::before {
    content: "✓";
    color: #e63946;
    font-weight: bold;
    margin-right: 8px;
}

.featured {
    border: 2px solid #e63946;
}

.popular {
    position: absolute;
    top: -14px;
    right: 20px;
    background: #e63946;
    color: white;
    padding: 5px 12px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: bold;
}


/* =========================
   REVIEWS
========================= */

.review {
    background: #101828;
    color: white;
}

.review .section-title p {
    color: #d0d5dd;
}

.review-card {
    background: #1d2939;
    border-radius: 16px;
    padding: 30px;
}

.stars {
    color: #fbbf24;
    margin-bottom: 15px;
}

.review-card p {
    color: #d0d5dd;
    margin-bottom: 20px;
}

.reviewer {
    font-weight: bold;
}


/* =========================
   BOOKING
========================= */

.booking-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 50px;
}

.contact-info h3 {
    font-size: 30px;
    margin-bottom: 15px;
}

.contact-info p {
    color: #667085;
    margin-bottom: 25px;
}

.contact-item {
    margin: 18px 0;
}

.contact-item strong {
    display: block;
}

.form {
    background: #f8fafc;
    padding: 35px;
    border-radius: 16px;
}

.form-group {
    margin-bottom: 18px;
}

.form label {
    display: block;
    margin-bottom: 7px;
    font-weight: 600;
}

.form input,
.form select,
.form textarea {
    width: 100%;
    padding: 13px;
    border: 1px solid #d0d5dd;
    border-radius: 8px;
    font-size: 15px;
    font-family: inherit;
}

.form textarea {
    min-height: 120px;
    resize: vertical;
}

.form button {
    width: 100%;
    border: none;
    cursor: pointer;
}


/* =========================
   FOOTER
========================= */

footer {
    background: #101828;
    color: white;
    padding: 50px 0 25px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 40px;
}

footer h3 {
    margin-bottom: 12px;
}

footer p,
footer li {
    color: #98a2b3;
}

footer ul {
    list-style: none;
}

footer li {
    margin: 8px 0;
}

.copyright {
    border-top: 1px solid #344054;
    padding-top: 20px;
    text-align: center;
    color: #98a2b3;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 800px) {

    .nav-links {
        display: none;
        position: absolute;
        top: 76px;
        left: 0;
        width: 100%;
        background: white;
        flex-direction: column;
        padding: 25px;
        border-bottom: 1px solid #eee;
    }

    .nav-links.active {
        display: flex;
    }

    .menu-button {
        display: block;
    }

    .stats-grid,
    .cards,
    .about-grid,
    .booking-grid,
    .footer-grid {
        grid-template-columns: 1fr;
    }

    .hero {
        padding: 80px 0;
    }

    section {
        padding: 65px 0;
    }

    .section-title h2 {
        font-size: 32px;
    }
}

</style>
</head>


